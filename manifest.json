{
  "manifest_version": 3,
  "name": "Gemini API Filter - FIXED",
  "version": "2.1",
  "description": "Filters PII in chatGPT prompts and documents using local file extraction API - FIXED VERSION",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://chatgpt.com/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ],

  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
